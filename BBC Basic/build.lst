  37  B0C0              			include "patch.z80"
# file opened: patch.z80
   1+ B0C0              ;
   2+ B0C0              ; Title:	BBC Basic for BSX
   3+ B0C0              ; Author:	Dean Belfield
   4+ B0C0              ; Created:	16/05/2020
   5+ B0C0              ; Last Updated:	08/10/2020
   6+ B0C0              ;
   7+ B0C0              ; Modinfo:
   8+ B0C0              ; 20/05/2020:	Added minimal OSCLI command (*BYE)
   9+ B0C0              ;		Uses RST instructions in latest ROM for I/O
  10+ B0C0              ; 10/06/2020:	Fixed COLOUR to use EXPRI instead of ITEMI so that calculations work without brackets, i.e. COLOUR 1+128
  11+ B0C0              ; 08/10/2020:	Minor mods to support UART
  12+ B0C0              ;
  13+ B0C0
  14+ B0C0              			MODULE PATCH
  15+ B0C0
  16+ B0C0              acia_control:	equ %01111110
  17+ B0C0              acia_data:		equ %01111111
  18+ B0C0              tdre_flag:		equ %00000010
  19+ B0C0              rdrf_flag:		equ %00000001
  20+ B0C0
  21+ B0C0              ; CLRSCN: clears the screen.
  22+ B0C0              ;
  23+ B0C0 CD 4B 8C     @CLRSCN:		CALL	TELL
  24+ B0C3 1B 5B 32 4A  			DEFB	0x1B,0x5B,"2J",0x1B,0x5B,"1;1H",0
  24+ B0C7 1B 5B 31 3B
  24+ B0CB 31 48 00
  25+ B0CE C9           			RET
  26+ B0CF
  27+ B0CF              ; PUTIME: set current time to DE:HL, in centiseconds.
  28+ B0CF              ;
  29+ B0CF C9           @PUTIME:		RET
  30+ B0D0
  31+ B0D0              ; GETIME: return current time in DE:HL, in centiseconds.
  32+ B0D0              ;
  33+ B0D0 11 00 00     @GETIME:		LD	DE, 0
  34+ B0D3 21 00 00      	  		LD	HL, 0
  35+ B0D6 C9           			RET
  36+ B0D7
  37+ B0D7              ; PUTCSR: move to cursor to x=DE, y=HL
  38+ B0D7              ;
  39+ B0D7 C9           @PUTCSR:		RET
  40+ B0D8
  41+ B0D8              ; GETCSR: return cursor position in x=DE, y=HL
  42+ B0D8              ;
  43+ B0D8 11 00 00     @GETCSR:		LD	DE,0
  44+ B0DB 21 00 00     			LD	HL,0
  45+ B0DE C9           			RET
  46+ B0DF
  47+ B0DF              ; OSRDCH: read a character in from the keyboard (non-blocking)
  48+ B0DF              ;
  49+ B0DF              @OSRDCH:
  50+ B0DF DB 7E        			IN A,(acia_control)
  51+ B0E1 E6 01        			and rdrf_flag
  52+ B0E3 C8           			ret z
  53+ B0E4 DB 7F        			in a,(acia_data)
  54+ B0E6 C9           			ret
  55+ B0E7
  56+ B0E7              ; PROMPT: output the input prompt
  57+ B0E7              ;
  58+ B0E7 3E 3E        @PROMPT: 		LD	A,'>'
  59+ B0E9
  60+ B0E9              ; OSWRCH: write a character out to the serial port
  61+ B0E9              ;
  62+ B0E9              @OSWRCH:
  63+ B0E9 F5           			push af
  64+ B0EA              waitch:
  65+ B0EA DB 7E        			in a,(acia_control)
  66+ B0EC E6 02        			and tdre_flag
  67+ B0EE 28 FA        			jr z,waitch
  68+ B0F0 F1           			pop af
  69+ B0F1 D3 7F        			out (acia_data),a
  70+ B0F3 C9           			ret
  71+ B0F4
  72+ B0F4              ;OSKEY - Read key with time-limit, test for ESCape.
  73+ B0F4              ;Main function is carried out in user patch.
  74+ B0F4              ;   Inputs: HL = time limit (centiseconds)
  75+ B0F4              ;  Outputs: Carry reset if time-out
  76+ B0F4              ;           If carry set A = character
  77+ B0F4              ; Destroys: A,H,L,F
  78+ B0F4              ;
  79+ B0F4 2B           @OSKEY:		DEC	HL
  80+ B0F5 7C           			LD	A,H
  81+ B0F6 B5           			OR	L
  82+ B0F7 C8           			RET	Z
  83+ B0F8 CD DF B0     			CALL OSRDCH
  84+ B0FB 28 F7        			JR Z,@OSKEY
  85+ B0FD FE 1B        			CP	0x1B		; ESC
  86+ B0FF 37           			SCF
  87+ B100 C0           			RET	NZ
  88+ B101 E5           ESCSET: 		PUSH    HL
  89+ B102 21 00 B6             		LD      HL,FLAGS
  90+ B105 CB 76                		BIT     6,(HL)          ; ESC DISABLED?
  91+ B107 20 02                		JR      NZ,ESCDIS
  92+ B109 CB FE                		SET     7,(HL)          ; SET ESCAPE FLAG
  93+ B10B E1           ESCDIS: 		POP     HL
  94+ B10C C9                   		RET
  95+ B10D              ESCTEST:
  96+ B10D CD DF B0     			CALL @OSRDCH
  97+ B110 C8           			RET Z
  98+ B111 FE 1B        			CP	0x1B		; ESC
  99+ B113 28 EC        			JR	Z,ESCSET
 100+ B115 C9           			RET
 101+ B116
 102+ B116 CD 0D B1     @TRAP:			CALL ESCTEST
 103+ B119 3A 00 B6     @LTRAP:			LD A,(FLAGS)
 104+ B11C B7           			OR A
 105+ B11D F0           			RET P
 106+ B11E 21 00 B6     			LD HL,FLAGS
 107+ B121 CB BE        			RES 7,(HL)
 108+ B123 C3 E2 8D     			JP ESCAPE
 109+ B126
 110+ B126              ;OSINIT - Initialise RAM mapping etc.
 111+ B126              ;If BASIC is entered by BBCBASIC FILENAME then file
 112+ B126              ;FILENAME.BBC is automatically CHAINed.
 113+ B126              ;   Outputs: DE = initial value of HIMEM (top of RAM)
 114+ B126              ;            HL = initial value of PAGE (user program)
 115+ B126              ;            Z-flag reset indicates AUTO-RUN.
 116+ B126              ;  Destroys: A,D,E,H,L,F
 117+ B126              ;
 118+ B126 AF           @OSINIT: 		XOR	A
 119+ B127 32 00 B6     			LD	(@FLAGS),A	;Clear flags
 120+ B12A 11 00 00              		LD 	DE,0x0000	;DE = HIMEM
 121+ B12D 5F                    		LD 	E,A             ;PAGE BOUNDARY
 122+ B12E 21 01 B6              		LD 	HL,@USER
 123+ B131 C9                    		RET
 124+ B132
 125+ B132              ;
 126+ B132              ;OSLINE - Read/edit a complete line, terminated by CR.
 127+ B132              ;   Inputs: HL addresses destination buffer.
 128+ B132              ;           (L=0)
 129+ B132              ;  Outputs: Buffer filled, terminated by CR.
 130+ B132              ;           A=0.
 131+ B132              ; Destroys: A,B,C,D,E,H,L,F
 132+ B132              ;
 133+ B132              @OSLINE:
 134+ B132 CD DF B0     			CALL OSRDCH
 135+ B135 28 FB        			JR	Z,OSLINE
 136+ B137 FE 0D        			CP	0x0D		; CR
 137+ B139 28 0F        			JR	Z,KEYCR
 138+ B13B FE 7F        			CP	0x7F		; Backspace
 139+ B13D 28 11        			JR	Z,KEYBS
 140+ B13F FE 08        			CP 0x08
 141+ B141 28 0D        			JR Z,KEYBS
 142+ B143 77           			LD	(HL),A		; Save the character in the buffer
 143+ B144 23           			INC	HL
 144+ B145 CD E9 B0     			CALL	OSWRCH		; Echo character back to terminal
 145+ B148 18 E8        			JR	OSLINE		; Loop
 146+ B14A
 147+ B14A 77           KEYCR:			LD	(HL),A		; Write final CR
 148+ B14B CD 8D 88     			CALL	@CRLF		; Print CR
 149+ B14E A7           			AND	A
 150+ B14F C9           			RET
 151+ B150
 152+ B150 2C           KEYBS:			INC	L		; Check for beginning of line
 153+ B151 2D           			DEC	L
 154+ B152 28 DE        			JR	Z,OSLINE
 155+ B154 CD E9 B0     			CALL OSWRCH
 156+ B157 3E 20        			LD A, ' '
 157+ B159 CD E9 B0     			CALL OSWRCH
 158+ B15C 3E 08        			LD A, 8
 159+ B15E CD E9 B0     			CALL OSWRCH
 160+ B161 2D           			DEC	L
 161+ B162 18 CE        			JR	OSLINE
 162+ B164
 163+ B164
 164+ B164              ;
 165+ B164              ;OSCLI - Process an "operating system" command
 166+ B164              ;
 167+ B164 CD BE B1     @OSCLI: 		CALL    SKIPSP
 168+ B167 FE 0D        			CP      CR
 169+ B169 C8           			RET     Z
 170+ B16A FE 7C        			CP      '|'
 171+ B16C C8           			RET     Z
 172+ B16D FE 2E        			CP      '.'
 173+ B16F CA D0 B1     			JP      Z,STARDOT	; *.
 174+ B172 EB           			EX      DE,HL
 175+ B173 21 F1 B1     			LD      HL,COMDS
 176+ B176 1A           OSCLI0:			LD      A,(DE)
 177+ B177 CD C5 B1     			CALL    UPPRC
 178+ B17A BE           			CP      (HL)
 179+ B17B 28 0B        			JR      Z,OSCLI2
 180+ B17D 38 2E        			JR      C,HUH
 181+ B17F CB 7E        OSCLI1:			BIT     7,(HL)
 182+ B181 23           			INC     HL
 183+ B182 28 FB        			JR      Z,OSCLI1
 184+ B184 23           			INC     HL
 185+ B185 23           			INC     HL
 186+ B186 18 EE        			JR      OSCLI0
 187+ B188              ;
 188+ B188 D5           OSCLI2:			PUSH    DE
 189+ B189 13           OSCLI3:			INC     DE
 190+ B18A 23           			INC     HL
 191+ B18B 1A           			LD      A,(DE)
 192+ B18C CD C5 B1     			CALL    UPPRC
 193+ B18F FE 2E        			CP      '.'		; ABBREVIATED?
 194+ B191 28 0A        			JR      Z,OSCLI4
 195+ B193 AE           			XOR     (HL)
 196+ B194 28 F3        			JR      Z,OSCLI3
 197+ B196 FE 80        			CP      80H
 198+ B198 28 03        			JR      Z,OSCLI4
 199+ B19A D1           			POP     DE
 200+ B19B 18 E2        			JR      OSCLI1
 201+ B19D              ;
 202+ B19D F1           OSCLI4:			POP     AF
 203+ B19E 13           		        INC     DE
 204+ B19F CB 7E        OSCLI5:			BIT     7,(HL)
 205+ B1A1 23           			INC     HL
 206+ B1A2 28 FB        			JR      Z,OSCLI5
 207+ B1A4 7E           			LD      A,(HL)
 208+ B1A5 23           			INC     HL
 209+ B1A6 66           			LD      H,(HL)
 210+ B1A7 6F           			LD      L,A
 211+ B1A8 E5           			PUSH    HL
 212+ B1A9 EB           			EX      DE,HL
 213+ B1AA C3 BE B1     			JP      SKIPSP
 214+ B1AD
 215+ B1AD 3E FE        HUH:    		LD      A,254
 216+ B1AF CD 10 87             		CALL    EXTERR
 217+ B1B2 42 61 64 20          		DEFM    'Bad command'
 217+ B1B6 63 6F 6D 6D
 217+ B1BA 61 6E 64
 218+ B1BD 00                   		DEFB    0
 219+ B1BE
 220+ B1BE 7E           SKIPSP:			LD      A,(HL)
 221+ B1BF FE 20                		CP      ' '
 222+ B1C1 C0                   		RET     NZ
 223+ B1C2 23                   		INC     HL
 224+ B1C3 18 F9                		JR      SKIPSP
 225+ B1C5
 226+ B1C5 E6 7F        UPPRC:  		AND     7FH
 227+ B1C7 FE 60        			CP      '`'
 228+ B1C9 D8           			RET     C
 229+ B1CA E6 5F        			AND     5FH		; CONVERT TO UPPER CASE
 230+ B1CC C9           			RET
 231+ B1CD              ; OSCLI - *BYE
 232+ B1CD              ;
 233+ B1CD C3 00 00     BYE:			JP	0
 234+ B1D0
 235+ B1D0              ; OSCLI - *CAT / *.
 236+ B1D0              ;
 237+ B1D0              STARDOT:
 238+ B1D0 3E 02        CAT:			LD 	A,0x02
 239+ B1D2 D3 01        			OUT	(PORT_STM_FILE),A
 240+ B1D4 C9           			RET
 241+ B1D5
 242+ B1D5              ; OSCLI - *DIR
 243+ B1D5              ;
 244+ B1D5 7E           DIR:			LD	A,(HL)
 245+ B1D6 FE 22        			CP	0x22		; Quote
 246+ B1D8 20 D3        			JR 	NZ,HUH
 247+ B1DA 23           			INC 	HL
 248+ B1DB 3E 01        			LD 	A,0x01
 249+ B1DD D3 01        			OUT	(PORT_STM_FILE),A
 250+ B1DF 7E           1:			LD 	A,(HL)
 251+ B1E0 FE 22        			CP	0x22
 252+ B1E2 28 09        			JR	Z,2F
 253+ B1E4 FE 0D        			CP	CR
 254+ B1E6 28 05        			JR 	Z,2F
 255+ B1E8 D3 01        			OUT	(PORT_STM_FILE),A
 256+ B1EA 23           			INC	HL
 257+ B1EB 18 F2        			JR 	1B
 258+ B1ED AF           2:			XOR	A
 259+ B1EE D3 01        			OUT	(PORT_STM_FILE),A
 260+ B1F0 C9           			RET
 261+ B1F1
 262+ B1F1              ; Each command has bit 7 of the last character set, and is followed by the address of the handler
 263+ B1F1              ;
 264+ B1F1 42 59 C5     COMDS:  		DC    	'BYE'
 264+ B1F4 CD B1         	DEFW BYE	; JP 0
 265+ B1F6 43 41 D4     			DC	'CAT'
 265+ B1F9 D0 B1         	DEFW CAT	; Catalogue SD Card
 266+ B1FB 44 49 D2     			DC	'DIR'
 266+ B1FE D5 B1         	DEFW DIR	; Change directory
 267+ B200 FF           			DEFB	0FFH
