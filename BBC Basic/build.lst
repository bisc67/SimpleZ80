   1+ B226              ;
   2+ B226              ;RAM MODULE FOR BBC BASIC INTERPRETER
   3+ B226              ;FOR USE WITH VERSION 2.0 OF BBC BASIC
   4+ B226              ;*STANDARD CP/M DISTRIBUTION VERSION*
   5+ B226              ;(C) COPYRIGHT R.T.RUSSELL 31-12-1983
   6+ B226              ;
   7+ B226
   8+ B226              			MODULE RAM
   9+ B226
  10+ B226              			IF BUILD_ROM = 0
  11+ B226 00 00 00...  			ALIGN 256
  12+ B300              			ELSE
  13+ B300 ~            			DISP RAM_START
  14+ B300              			ENDIF
  15+ B300              ;
  16+ B300              ;n.b. ACCS, BUFFER & STAVAR must be on page boundaries.
  17+ B300              ;
  18+ B300 00 00 00...  @ACCS:			DEFS    256             ;STRING ACCUMULATOR
  19+ B400 00 00 00...  @BUFFER:		DEFS    256             ;STRING INPUT BUFFER
  20+ B500 00 00 00...  @STAVAR:		DEFS    27*4            ;STATIC VARIABLES
  21+ B56C              @OC:			EQU     STAVAR+15*4     ;CODE ORIGIN (O%)
  22+ B56C              @PC:			EQU     STAVAR+16*4     ;PROGRAM COUNTER (P%)
  23+ B56C 00 00 00...  @DYNVAR: 		DEFS    54*2            ;DYN. VARIABLE POINTERS
  24+ B5D8 00 00        @FNPTR:  		DEFS    2               ;DYN. FUNCTION POINTER
  25+ B5DA 00 00        @PROPTR: 		DEFS    2               ;DYN. PROCEDURE POINTER
  26+ B5DC              ;
  27+ B5DC 00 00        @PAGE:   		DEFS    2               ;START OF USER PROGRAM
  28+ B5DE 00 00        @TOP:    		DEFS    2               ;FIRST LOCN AFTER PROG.
  29+ B5E0 00 00        @LOMEM:  		DEFS    2               ;START OF DYN. STORAGE
  30+ B5E2 00 00        @FREE:   		DEFS    2               ;FIRST FREE-SPACE BYTE
  31+ B5E4 00 00        @HIMEM:  		DEFS    2               ;FIRST PROTECTED BYTE
  32+ B5E6              ;
  33+ B5E6 00 00        @LINENO: 		DEFS    2               ;LINE NUMBER
  34+ B5E8 00 00        @TRACEN:		DEFS    2               ;TRACE FLAG
  35+ B5EA 00 00        @AUTONO:		DEFS    2               ;AUTO FLAG
  36+ B5EC 00 00        @ERRTRP:		DEFS    2               ;ERROR TRAP
  37+ B5EE 00 00        @ERRTXT:		DEFS    2               ;ERROR MESSAGE POINTER
  38+ B5F0 00 00        @DATPTR:		DEFS    2               ;DATA POINTER
  39+ B5F2 00 00        @ERL:			DEFS    2               ;ERROR LINE
  40+ B5F4 00 00        @ERRLIN:		DEFS    2               ;"ON ERROR" LINE
  41+ B5F6 00 00 00...  @RANDOM:		DEFS    5               ;RANDOM NUMBER
  42+ B5FB 00           @COUNT:			DEFS    1               ;PRINT POSITION
  43+ B5FC 00           @WIDTH:			DEFS    1               ;PRINT WIDTH
  44+ B5FD 00           @ERR:			DEFS    1               ;ERROR NUMBER
  45+ B5FE 00           @LISTON:		DEFS    1               ;LISTO & OPT FLAG
  46+ B5FF 00           @INCREM:		DEFS    1               ;AUTO INCREMENT
  47+ B600              ;
  48+ B600              ; Added by me
  49+ B600              ;
  50+ B600 00           @FLAGS:			DEFS	1		; Flags: B7=ESC PRESSED, B6=ESC DISABLED
  51+ B601
  52+ B601              			ENDMODULE
