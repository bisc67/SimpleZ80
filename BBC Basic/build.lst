   4+ A4BC              ;VERSION 0.0, 26-10-1986
   5+ A4BC              ;VERSION 0.1, 14-12-1988 (BUG FIX)
   6+ A4BC              ;
   7+ A4BC              ;BINARY FLOATING POINT REPRESENTATION:
   8+ A4BC              ;   32 BIT SIGN-MAGNITUDE NORMALIZED MANTISSA
   9+ A4BC              ;    8 BIT EXCESS-128 SIGNED EXPONENT
  10+ A4BC              ;   SIGN BIT REPLACES MANTISSA MSB (IMPLIED "1")
  11+ A4BC              ;   MANTISSA=0 & EXPONENT=0 IMPLIES VALUE IS ZERO.
  12+ A4BC              ;
  13+ A4BC              ;BINARY INTEGER REPRESENTATION:
  14+ A4BC              ;   32 BIT 2'S-COMPLEMENT SIGNED INTEGER
  15+ A4BC              ;    "EXPONENT" BYTE = 0 (WHEN PRESENT)
  16+ A4BC              ;
  17+ A4BC              ;NORMAL REGISTER ALLOCATION: MANTISSA - HLH'L'
  18+ A4BC              ;                            EXPONENT - C
  19+ A4BC              ;ALTERNATE REGISTER ALLOCATION: MANTISSA - DED'E'
  20+ A4BC              ;                               EXPONENT - B
  21+ A4BC              ;
  22+ A4BC              ;Error codes:
  23+ A4BC              ;
  24+ A4BC              			MODULE FPP
  25+ A4BC
  26+ A4BC              BADOP:			EQU     1               ;Bad operation code
  27+ A4BC              DIVBY0:			EQU     18              ;Division by zero
  28+ A4BC              TOOBIG:			EQU     20              ;Too big
  29+ A4BC              NGROOT:			EQU     21              ;Negative root
  30+ A4BC              LOGRNG:			EQU     22              ;Log range
  31+ A4BC              ACLOST:			EQU     23              ;Accuracy lost
  32+ A4BC              EXPRNG:			EQU     24              ;Exp range
  33+ A4BC              ;
  34+ A4BC              ;Call entry and despatch code:
  35+ A4BC              ;
  36+ A4BC FD E5        @FPP:			PUSH    IY              ;Save IY
  37+ A4BE FD 21 00 00          		LD      IY,0
  38+ A4C2 FD 39                		ADD     IY,SP           ;Save SP in IY
  39+ A4C4 CD D3 A4             		CALL    OP              ;Perform operation
  40+ A4C7 BF                   		CP      A               ;Good return (Z, NC)
  41+ A4C8 FD E1        EXIT:			POP     IY              ;Restore IY
  42+ A4CA C9                   		RET                     ;Return to caller
  43+ A4CB              ;
  44+ A4CB              ;Error exit:
  45+ A4CB              ;
  46+ A4CB 3E 01        BAD:			LD      A,BADOP         ;"Bad operation code"
  47+ A4CD FD F9        ERROR:			LD      SP,IY           ;Restore SP from IY
  48+ A4CF B7                   		OR      A               ;Set NZ
  49+ A4D0 37                   		SCF                     ;Set C
  50+ A4D1 18 F5                		JR      EXIT
  51+ A4D3              ;
  52+ A4D3              ;Perform operation or function:
  53+ A4D3              ;
  54+ A4D3 FE 2A        OP:			CP      (RTABLE-DTABLE)/2
  55+ A4D5 30 F4                		JR      NC,BAD
  56+ A4D7 FE 10                		CP      (FTABLE-DTABLE)/2
  57+ A4D9 30 07                		JR      NC,DISPAT
  58+ A4DB 08                   		EX      AF,AF'
  59+ A4DC 78                   		LD      A,B
  60+ A4DD B1                   		OR      C               ;Both integer?
  61+ A4DE C4 5D AE             		CALL    NZ,FLOATA       ;No, so float both
  62+ A4E1 08                   		EX      AF,AF'
  63+ A4E2 E5           DISPAT:			PUSH    HL
  64+ A4E3 21 F3 A4             		LD      HL,DTABLE
  65+ A4E6 C5                   		PUSH    BC
  66+ A4E7 87                   		ADD     A,A             ;A = op-code * 2
  67+ A4E8 4F                   		LD      C,A
  68+ A4E9 06 00                		LD      B,0             ;BC = op-code * 2
  69+ A4EB 09                   		ADD     HL,BC
  70+ A4EC 7E                   		LD      A,(HL)          ;Get low byte
  71+ A4ED 23                   		INC     HL
  72+ A4EE 66                   		LD      H,(HL)          ;Get high byte
  73+ A4EF 6F                   		LD      L,A
  74+ A4F0 C1                   		POP     BC
  75+ A4F1 E3                   		EX      (SP),HL
  76+ A4F2 C9                   		RET                     ;Off to routine
  77+ A4F3              ;
  78+ A4F3              ;Despatch table:
  79+ A4F3              ;
  80+ A4F3 6A A5        DTABLE:			DEFW    IAND            ;AND (INTEGER)
  81+ A4F5 CD A5                		DEFW    IBDIV           ;DIV
  82+ A4F7 7C A5                		DEFW    IEOR            ;EOR
  83+ A4F9 A0 A5                		DEFW    IMOD            ;MOD
  84+ A4FB 8E A5                		DEFW    IOR             ;OR
  85+ A4FD FC A7                		DEFW    ILE             ;<=
  86+ A4FF 09 A8                		DEFW    INE             ;<>
  87+ A501 F1 A7                		DEFW    IGE             ;>=
  88+ A503 DA A7                		DEFW    ILT             ;<
  89+ A505 14 A8                		DEFW    IEQ             ;=
  90+ A507 97 A6                		DEFW    IMUL            ;*
  91+ A509 F0 A5                		DEFW    IADD            ;+
  92+ A50B E5 A7                		DEFW    IGT             ;>
  93+ A50D DA A5                		DEFW    ISUB            ;-
  94+ A50F 35 A7                		DEFW    IPOW            ;^
  95+ A511 4F A6                		DEFW    IDIV            ;/
  96+ A513              ;
  97+ A513 23 A8        FTABLE:			DEFW    ABSFN             ;ABS
  98+ A515 7F AB                		DEFW    ACS             ;ACS
  99+ A517 DB AA                		DEFW    ASN             ;ASN
 100+ A519 00 AB                		DEFW    ATN             ;ATN
 101+ A51B 19 A9                		DEFW    COS             ;COS
 102+ A51D 4D A8                		DEFW    DEG             ;DEG
 103+ A51F BE A9                		DEFW    EXP             ;EXP
 104+ A521 93 A8                		DEFW    INT             ;INT
 105+ A523 49 AA                		DEFW    LN              ;LN
 106+ A525 C9 AA                		DEFW    LOG             ;LOG
 107+ A527 2E A8                		DEFW    NOTK            ;NOT
 108+ A529 55 A8                		DEFW    RAD             ;RAD
 109+ A52B 6B A8                		DEFW    SGN             ;SGN
 110+ A52D 24 A9                		DEFW    SIN             ;SIN
 111+ A52F A9 A8                		DEFW    SQR             ;SQR
 112+ A531 FC A8                		DEFW    TAN             ;TAN
 113+ A533              ;
 114+ A533 D9 AE        		        DEFW    ZERO            ;ZERO
 115+ A535 9D A9                		DEFW    FONE            ;FONE
 116+ A537 18 A8                		DEFW    TRUE            ;TRUE
 117+ A539 41 A8                		DEFW    PI              ;PI
 118+ A53B              ;
 119+ A53B 7B A8        		        DEFW    VAL             ;VAL
 120+ A53D 87 AB                		DEFW    STR             ;STR$
 121+ A53F              ;
 122+ A53F AE AD                		DEFW    SFIX            ;FIX
 123+ A541 6A AE                		DEFW    SFLOAT          ;FLOAT
 124+ A543              ;
 125+ A543 AF AE        		        DEFW    FTEST           ;TEST
 126+ A545 C0 AE                		DEFW    FCOMP           ;COMPARE
 127+ A547              ;
 128+ A547 67 A5        RTABLE:			DEFW    FAND            ;AND (FLOATING-POINT)
 129+ A549 CA A5                		DEFW    FBDIV           ;DIV
 130+ A54B 79 A5                		DEFW    FEOR            ;EOR
 131+ A54D 9D A5                		DEFW    FMOD            ;MOD
 132+ A54F 8B A5                		DEFW    FOR             ;OR
 133+ A551 F7 A7                		DEFW    FLE             ;<=
 134+ A553 04 A8                		DEFW    FNE             ;<>
 135+ A555 EC A7                		DEFW    FGE             ;>=
 136+ A557 D5 A7                		DEFW    FLT             ;<
 137+ A559 0F A8                		DEFW    FEQ             ;=
 138+ A55B E5 A6                		DEFW    FMUL            ;*
 139+ A55D FA A5                		DEFW    FADD            ;+
 140+ A55F E0 A7                		DEFW    FGT             ;>
 141+ A561 E4 A5                		DEFW    FSUB            ;-
 142+ A563 AB A7                		DEFW    FPOW            ;^
 143+ A565 52 A6                		DEFW    FDIV            ;/
 144+ A567              ;
 145+ A567              ;       PAGE
 146+ A567              ;
 147+ A567              ;ARITHMETIC AND LOGICAL OPERATORS:
 148+ A567              ;All take two arguments, in HLH'L'C & DED'E'B.
 149+ A567              ;Output in HLH'L'C
 150+ A567              ;All registers except IX, IY destroyed.
 151+ A567              ; (N.B. FPOW destroys IX).
 152+ A567              ;
 153+ A567              ;FAND - Floating-point AND.
 154+ A567              ;IAND - Integer AND.
 155+ A567              ;
 156+ A567 CD A5 AD     FAND:			CALL    FIX2
 157+ A56A 7C           IAND:			LD      A,H
 158+ A56B A2                   		AND     D
 159+ A56C 67                   		LD      H,A
 160+ A56D 7D                   		LD      A,L
 161+ A56E A3                   		AND     E
 162+ A56F 6F                   		LD      L,A
 163+ A570 D9                   		EXX
 164+ A571 7C                   		LD      A,H
 165+ A572 A2                   		AND     D
 166+ A573 67                   		LD      H,A
 167+ A574 7D                   		LD      A,L
 168+ A575 A3                   		AND     E
 169+ A576 6F                   		LD      L,A
 170+ A577 D9                   		EXX
 171+ A578 C9                   		RET
 172+ A579              ;
 173+ A579              ;FEOR - Floating-point exclusive-OR.
 174+ A579              ;IEOR - Integer exclusive-OR.
 175+ A579              ;
 176+ A579 CD A5 AD     FEOR:			CALL    FIX2
 177+ A57C 7C           IEOR:			LD      A,H
 178+ A57D AA                   		XOR     D
 179+ A57E 67                   		LD      H,A
 180+ A57F 7D                   		LD      A,L
 181+ A580 AB                   		XOR     E
 182+ A581 6F                   		LD      L,A
 183+ A582 D9                   		EXX
 184+ A583 7C                   		LD      A,H
 185+ A584 AA                   		XOR     D
 186+ A585 67                   		LD      H,A
 187+ A586 7D                   		LD      A,L
 188+ A587 AB                   		XOR     E
 189+ A588 6F                   		LD      L,A
 190+ A589 D9                   		EXX
 191+ A58A C9                   		RET
 192+ A58B              ;
 193+ A58B              ;FOR - Floating-point OR.
 194+ A58B              ;IOR - Integer OR.
 195+ A58B              ;
 196+ A58B CD A5 AD     FOR:			CALL    FIX2
 197+ A58E 7C           IOR:			LD      A,H
 198+ A58F B2                   		OR      D
 199+ A590 67                   		LD      H,A
 200+ A591 7D                   		LD      A,L
 201+ A592 B3                   		OR      E
 202+ A593 6F                   		LD      L,A
 203+ A594 D9                   		EXX
 204+ A595 7C                   		LD      A,H
 205+ A596 B2                   		OR      D
 206+ A597 67                   		LD      H,A
 207+ A598 7D                   		LD      A,L
 208+ A599 B3                   		OR      E
 209+ A59A 6F                   		LD      L,A
 210+ A59B D9                   		EXX
 211+ A59C C9                   		RET
 212+ A59D              ;
 213+ A59D              ;FMOD - Floating-point remainder.
 214+ A59D              ;IMOD - Integer remainder.
 215+ A59D              ;
 216+ A59D CD A5 AD     FMOD:			CALL    FIX2
 217+ A5A0 7C           IMOD:			LD      A,H
 218+ A5A1 AA                   		XOR     D               ;DIV RESULT SIGN
 219+ A5A2 CB 7C                		BIT     7,H
 220+ A5A4 08                   		EX      AF,AF'
 221+ A5A5 CB 7C                		BIT     7,H
 222+ A5A7 C4 BD AD             		CALL    NZ,NEGATE       ;MAKE ARGUMENTS +VE
 223+ A5AA CD 94 AE             		CALL    SWAP
 224+ A5AD CB 7C                		BIT     7,H
 225+ A5AF C4 BD AD             		CALL    NZ,NEGATE
 226+ A5B2 44                   		LD      B,H
 227+ A5B3 4D                   		LD      C,L
 228+ A5B4 21 00 00             		LD      HL,0
 229+ A5B7 D9                   		EXX
 230+ A5B8 44                   		LD      B,H
 231+ A5B9 4D                   		LD      C,L
 232+ A5BA 21 00 00             		LD      HL,0
 233+ A5BD 3E DF                		LD      A,-33
 234+ A5BF CD E9 AF             		CALL    DIVA            ;DIVIDE
 235+ A5C2 D9                   		EXX
 236+ A5C3 0E 00                		LD      C,0             ;INTEGER MARKER
 237+ A5C5 08                   		EX      AF,AF'
 238+ A5C6 C8                   		RET     Z
 239+ A5C7 C3 BD AD             		JP      NEGATE
 240+ A5CA              ;
 241+ A5CA              ;BDIV - Integer division.
 242+ A5CA              ;
 243+ A5CA CD A5 AD     FBDIV:			CALL    FIX2
 244+ A5CD CD A0 A5     IBDIV:			CALL    IMOD
 245+ A5D0 B7                   		OR      A
 246+ A5D1 CD 94 AE             		CALL    SWAP
 247+ A5D4 0E 00                		LD      C,0
 248+ A5D6 F0                   		RET     P
 249+ A5D7 C3 BD AD             		JP      NEGATE
 250+ A5DA              ;
 251+ A5DA              ;ISUB - Integer subtraction.
 252+ A5DA              ;FSUB - Floating point subtraction with rounding.
 253+ A5DA              ;
 254+ A5DA CD 1C AF     ISUB:			CALL    SUB
 255+ A5DD E0                   		RET     PO
 256+ A5DE CD 16 AF             		CALL    ADD
 257+ A5E1 CD 61 AE             		CALL    FLOAT2
 258+ A5E4 7A           FSUB:			LD      A,D
 259+ A5E5 EE 80                		XOR     80H             ;CHANGE SIGN THEN ADD
 260+ A5E7 57                   		LD      D,A
 261+ A5E8 18 10                		JR      FADD
 262+ A5EA              ;
 263+ A5EA              ;Reverse subtract.
 264+ A5EA              ;
 265+ A5EA 7C           RSUB:			LD      A,H
 266+ A5EB EE 80                		XOR     80H
 267+ A5ED 67                   		LD      H,A
 268+ A5EE 18 0A                		JR      FADD
 269+ A5F0              ;
 270+ A5F0              ;IADD - Integer addition.
 271+ A5F0              ;FADD - Floating point addition with rounding.
 272+ A5F0              ;
 273+ A5F0 CD 16 AF     IADD:			CALL    ADD
 274+ A5F3 E0                   		RET     PO
 275+ A5F4 CD 1C AF             		CALL    SUB
 276+ A5F7 CD 61 AE             		CALL    FLOAT2
 277+ A5FA 05           FADD:			DEC     B
 278+ A5FB 04                   		INC     B
 279+ A5FC C8                   		RET     Z               ;ARG 2 ZERO
 280+ A5FD 0D                   		DEC     C
 281+ A5FE 0C                   		INC     C
 282+ A5FF CA 94 AE             		JP      Z,SWAP          ;ARG 1 ZERO
 283+ A602 D9                   		EXX
 284+ A603 01 00 00             		LD      BC,0            ;INITIALISE
 285+ A606 D9                   		EXX
 286+ A607 7C                   		LD      A,H
 287+ A608 AA                   		XOR     D               ;XOR SIGNS
 288+ A609 F5                   		PUSH    AF
 289+ A60A 78                   		LD      A,B
 290+ A60B B9                   		CP      C               ;COMPARE EXPONENTS
 291+ A60C DC 94 AE             		CALL    C,SWAP          ;MAKE DED'E'B LARGEST
 292+ A60F 78                   		LD      A,B
 293+ A610 CB FC                		SET     7,H             ;IMPLIED 1
 294+ A612 C4 95 AD             		CALL    NZ,FIX          ;ALIGN
 295+ A615 F1                   		POP     AF
 296+ A616 7A                   		LD      A,D             ;SIGN OF LARGER
 297+ A617 CB FA                		SET     7,D             ;IMPLIED 1
 298+ A619 FA 26 A6             		JP      M,FADD3         ;SIGNS DIFFERENT
 299+ A61C CD 16 AF             		CALL    ADD             ;HLH'L'=HLH'L'+DED'E'
 300+ A61F DC 9C AE             		CALL    C,DIV2          ;NORMALISE
 301+ A622 CB FC                		SET     7,H
 302+ A624 18 0A                		JR      FADD4
 303+ A626              ;
 304+ A626 CD 1C AF     FADD3:			CALL    SUB             ;HLH'L'=HLH'L'-DED'E'
 305+ A629 DC D1 AD             		CALL    C,NEG           ;NEGATE HLH'L'B'C'
 306+ A62C CD 3E AE             		CALL    FLO48
 307+ A62F 2F                   		CPL                     ;CHANGE RESULT SIGN
 308+ A630 D9           FADD4:			EXX
 309+ A631 EB                   		EX      DE,HL
 310+ A632 21 00 80             		LD      HL,8000H
 311+ A635 B7                   		OR      A               ;CLEAR CARRY
 312+ A636 ED 42                		SBC     HL,BC
 313+ A638 EB                   		EX      DE,HL
 314+ A639 D9                   		EXX
 315+ A63A CC 8E AE             		CALL    Z,ODD           ;ROUND UNBIASSED
 316+ A63D DC 80 AE             		CALL    C,ADD1          ;ROUND UP
 317+ A640 DC A8 AE             		CALL    C,INCC
 318+ A643 CB BC                		RES     7,H
 319+ A645 0D                   		DEC     C
 320+ A646 0C                   		INC     C
 321+ A647 CA D9 AE             		JP      Z,ZERO
 322+ A64A B7                   		OR      A               ;RESULT SIGNQ
 323+ A64B F0                   		RET     P               ;POSITIVE
 324+ A64C CB FC                		SET     7,H             ;NEGATIVE
 325+ A64E C9                   		RET
 326+ A64F              ;
 327+ A64F              ;IDIV - Integer division.
 328+ A64F              ;FDIV - Floating point division with rounding.
 329+ A64F              ;
 330+ A64F CD 61 AE     IDIV:			CALL    FLOAT2
 331+ A652 05           FDIV:			DEC     B               ;TEST FOR ZERO
 332+ A653 04                   		INC     B
