  10+ 9D26              ;BINARY FLOATING POINT REPRESENTATION:
  11+ 9D26              ;   32 BIT SIGN-MAGNITUDE NORMALIZED MANTISSA
  12+ 9D26              ;    8 BIT EXCESS-128 SIGNED EXPONENT
  13+ 9D26              ;   SIGN BIT REPLACES MANTISSA MSB (IMPLIED "1")
  14+ 9D26              ;   MANTISSA=0 & EXPONENT=0 IMPLIES VALUE IS ZERO.
  15+ 9D26              ;
  16+ 9D26              ;BINARY INTEGER REPRESENTATION:
  17+ 9D26              ;   32 BIT 2'S-COMPLEMENT SIGNED INTEGER
  18+ 9D26              ;    "EXPONENT" BYTE = 0 (WHEN PRESENT)
  19+ 9D26              ;
  20+ 9D26              ;NORMAL REGISTER ALLOCATION: MANTISSA - HLH'L'
  21+ 9D26              ;                            EXPONENT - C
