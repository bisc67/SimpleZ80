 362+ A682 ED 42                		SBC     HL,BC           ;REMAINDER-DIVISOR/2
 363+ A684 3F                   		CCF
 364+ A685 EB                   		EX      DE,HL           ;RESULT IN HLH'L'
 365+ A686 CC 8E AE             		CALL    Z,ODD           ;ROUND UNBIASSED
 366+ A689 DC 80 AE             		CALL    C,ADD1          ;ROUND UP
